# YOLO dataset config — copy to your server datasets directory:
#   cp dataset.yaml.example /data2/zhiyuanwei/datasets/dataset.yaml
#
# Docker mount: -v /data2/zhiyuanwei/datasets:/data:ro
# cv_agent uses container path: /data/dataset.yaml

# Dataset root (absolute path inside the container)
path: /data/dataset

train: images/train
val: images/val
# test: images/test  # optional

# Class names — edit to match your labels (id must be 0..N-1)
names:
  0: class_a
  1: class_b
  # 2: class_c
