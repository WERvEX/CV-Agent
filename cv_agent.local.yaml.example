# Optional git-ignored secret overrides. Copy only if needed:
#   cp cv_agent.local.yaml.example cv_agent.local.yaml
#
# Training profiles live in tracked YAML files:
#   cv_agent.yaml        formal full-COCO training
#   cv_agent.quick.yaml  COCO128 smoke test
#
# This file deep-merges on top of the selected profile. Keep it for secrets only.
# Prefer environment variables on servers:
#   export CV_AGENT_LLM_KEY="sk-..."

llm:
  api_key: ""
