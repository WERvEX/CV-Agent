# Optional git-ignored overrides. Copy to cv_agent.local.yaml only if needed:
#   cp cv_agent.local.yaml.example cv_agent.local.yaml
#
# Default behavior: all settings come from cv_agent.yaml (tracked in git).
# This file deep-merges on top — include ONLY keys you want to change.
# No local file? cv_agent runs fine with cv_agent.yaml alone.

# model_verbose: true  # opt in only when you need full Ultralytics model details

# --- Secrets (recommended: use env var instead of this file) ---
#   export CV_AGENT_LLM_KEY="sk-..."
llm:
  api_key: ""

# --- Optional overrides (uncomment as needed) ---
# interaction_mode: auto   # Docker / nohup / non-interactive servers
# mlflow_uri: http://mlflow.internal:5000
#
# Docker/server COCO without Ultralytics auto-download:
# mount host ./datasets to /app/datasets and use the bundled /app/coco_local.yaml.
# data:
#   data_yaml: /app/coco_local.yaml
